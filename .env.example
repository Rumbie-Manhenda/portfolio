# Portfolio email configuration
# ---------------------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is git-ignored, so your password is never committed.
#
#     copy .env.example .env        (Windows)
#     cp   .env.example .env        (macOS / Linux)
#
# Gmail setup (recommended):
#   1. Turn on 2-Step Verification for your Google account.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an app password named "Portfolio", copy the 16-character value.
#   4. Put your normal Gmail address in SMTP_USER and the app password in
#      SMTP_PASS below. Do NOT use your normal Google password.
# ---------------------------------------------------------------------------

# Port the web server listens on
PORT=3000

# --- Sending (SMTP) --------------------------------------------------------
# Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Your mailbox and the app password generated for it
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password

# --- Addresses -------------------------------------------------------------
# Where notification emails are sent (your inbox)
MAIL_TO=pattymcharis15@gmail.com

# The "From" address on the notifications. Leave blank to use SMTP_USER.
MAIL_FROM=you@gmail.com

# --- CORS ------------------------------------------------------------------
# "*" allows the form to be posted from any origin (simplest). To lock it down,
# list the exact site origins separated by commas, e.g.
#   ALLOWED_ORIGINS=https://patriciamanhenda.com,http://localhost:3000
ALLOWED_ORIGINS=*

# Set to true only while testing to switch off the spam limiter.
RATE_LIMIT_DISABLED=false
